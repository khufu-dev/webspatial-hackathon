{
  "name": "webspatial-hackathon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "node scripts/build-orbits.mjs",
    "test:solar": "node --experimental-strip-types --test tests/solar.test.mjs tests/solar-xr.test.mjs",
    "lint": "tsc --build",
    "build": "npm run build:wasm && npm run lint && vite build",
    "preview": "npm run build && vite preview --host --port 5173",
    "avp": "npm run build && webspatial-builder run --base=http://localhost:5173",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,html,md}\""
  },
  "dependencies": {
    "@webspatial/core-sdk": "latest",
    "@webspatial/react-sdk": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "latest",
    "@webspatial/builder": "latest",
    "@webspatial/platform-visionos": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wabt": "^1.0.39"
  }
}
